            }
          }
        },
        "fact_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "parameters_locked",
            "price_locked",
            "note"
          ],
          "properties": {
            "mode": {
              "const": "verbatim_excerpts"
            },
            "parameters_locked": {
              "const": true
            },
            "price_locked": {
              "const": true
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "variant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seed",
            "title",
            "opener"
          ],
          "properties": {
            "seed": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "integer",
              "minimum": 0
            },
            "opener": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "publish_copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "text_ready",
        "title",
        "markdown",
        "character_count",
        "tags",
        "fact_excerpts",
        "image_order",
        "source_note",
        "body"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "text_only_ready",
            "blocked"
          ]
        },
        "text_ready": {
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "markdown": {
          "type": "string",
          "minLength": 1
        },
        "character_count": {
          "type": "integer",
          "minimum": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fact_excerpts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "heading",
              "label",
              "value",
              "quote",
              "source_title"
            ],
            "properties": {
              "heading": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "source_title": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "image_order": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "order",
              "file_name",
              "caption",
              "position",
              "asset_url",
              "instruction",
              "rights_status",
              "publication_ready"
            ],
            "properties": {
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "file_name": {
                "type": "string",
                "minLength": 1
              },
              "caption": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "enum": [
                  "cover",
                  "scene",
                  "detail",
                  "before_cta"
                ]
              },
              "asset_url": {
                "type": "string",
                "minLength": 1
              },
              "instruction": {
                "type": "string",
                "minLength": 1
              },
              "rights_status": {
                "type": "string",
                "minLength": 1
              },
              "publication_ready": {
                "type": "boolean"
              }
            }
          }
        },
        "source_note": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string"
        }
      }
    },
    "publication_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "rules_checked_at",
        "platform_id",
        "copy_blocks",
        "cover_copy",
        "image_pack",
        "checks"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "rules_checked_at": {
          "type": "string",
          "minLength": 1
        },
        "platform_id": {
          "enum": [
            "wechat_article",
            "xiaohongshu_note",
            "moments_short_post"
          ]
        },
        "copy_blocks": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "text",
              "character_count",
              "status",
              "counter",
              "note"
            ],
            "properties": {
              "id": {
                "enum": [
                  "title",
                  "body",
                  "tags"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string"
              },
              "character_count": {
                "type": "integer",
                "minimum": 0
              },
              "status": {
                "enum": [
                  "pass",
                  "warning",
                  "fail",
                  "info"
                ]
              },
              "counter": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "cover_copy": {
          "type": "object",
          "required": [
            "eyebrow",
            "headline",
            "support",
            "badge",
            "footer",
            "copy_text",
            "suggested_layout",
            "safety_note"
          ],
          "properties": {
            "eyebrow": {
              "type": "string",
              "minLength": 1
            },
            "headline": {
              "type": "string",
              "minLength": 1
            },
            "support": {
              "type": "string",
              "minLength": 1
            },
            "badge": {
              "type": "string",
              "minLength": 1
            },
            "footer": {
              "type": "string",
              "minLength": 1
            },
            "copy_text": {
              "type": "string",
              "minLength": 1
            },
            "suggested_layout": {
              "type": "string",
              "minLength": 1
            },
            "safety_note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "image_pack": {
          "type": "object",
          "required": [
            "status",
            "authorized_count",
            "total_count",
            "note",
            "items"
          ],
          "properties": {
            "status": {
              "enum": [
                "empty",
                "review_only_rights_pending",
                "authorized_ready"
              ]
            },
            "authorized_count": {
              "type": "integer",
              "minimum": 0
            },
            "total_count": {
              "type": "integer",
              "minimum": 0
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "checks": {
          "type": "object",
          "required": [
            "overall_status",
            "summary",
            "items",
            "layout",
            "note"
          ],
          "properties": {
            "overall_status": {
              "enum": [
                "pass",
                "warning",
                "fail"
              ]
            },
            "summary": {
              "type": "object"
            },
            "items": {
              "type": "array",
              "minItems": 5,
              "items": {
                "type": "object"
              }
            },
            "layout": {
              "type": "object"
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "platform_matrix": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "platform",
              "platform_id",
              "selected",
              "status",
              "summary",
              "copy_blocks",
              "cover_copy",
              "checks"
            ],
            "properties": {
              "platform": {
                "enum": [
                  "公众号",
                  "小红书",
                  "朋友圈"
                ]
              },
              "platform_id": {
                "enum": [
                  "wechat_article",
                  "xiaohongshu_note",
                  "moments_short_post"
                ]
              },
              "selected": {
                "type": "boolean"
              },
              "status": {
                "enum": [
                  "pass",
                  "warning",
                  "fail"
                ]
              },
              "summary": {
                "type": "object"
              },
              "copy_blocks": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "object"
                }
              },
              "cover_copy": {
                "type": "object"
              },
              "checks": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
