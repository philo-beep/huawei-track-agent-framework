{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:huawei-growth:content-generation-output:1.2",
  "title": "多平台内容生成与强制核验输出 v1.2",
  "description": "基于客户画像、平台规则、所选候选和可追溯证据生成的审稿稿；固定覆盖公众号、小红书、朋友圈，并输出型号、预算、来源和六项发布核验。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "synthetic", "generated_at", "platform", "platform_profile", "product", "profile_basis", "budget_assessment", "draft", "image_sources", "insertion_plan", "citations", "verification", "article_markdown", "diagnostics"],
  "properties": {
    "schema_version": {"const": "1.2"},
    "status": {"enum": ["ready_for_review", "blocked"]},
    "synthetic": {"type": "boolean"},
    "generated_at": {"type": "string", "minLength": 1},
    "platform": {"enum": ["公众号", "小红书", "朋友圈"]},
    "platform_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "content_goal", "format", "max_facts", "image_limit", "image_policy", "source_policy", "data_sources"],
      "properties": {
        "id": {"enum": ["wechat_article", "xiaohongshu_note", "moments_short_post"]},
        "label": {"enum": ["公众号", "小红书", "朋友圈"]},
        "content_goal": {"type": "string", "minLength": 1},
        "format": {"type": "string", "minLength": 1},
        "max_facts": {"type": "integer", "minimum": 1, "maximum": 3},
        "image_limit": {"type": "integer", "minimum": 1, "maximum": 6},
        "image_policy": {"type": "string", "minLength": 1},
        "source_policy": {"type": "string", "minLength": 1},
        "data_sources": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["local_kb_index", "image_review_registry"]}}
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "requested_name", "resolved_name", "model_key", "family", "category", "operating_system", "model_verified"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "requested_name": {"type": "string", "minLength": 1},
        "resolved_name": {"type": "string", "minLength": 1},
        "model_key": {"type": ["string", "null"], "enum": ["matebook-14-harmonyos", "matebook-14-2024", null]},
        "family": {"type": ["string", "null"]},
        "category": {"type": ["string", "null"]},
        "operating_system": {"type": ["string", "null"]},
        "model_verified": {"type": "boolean"}
      }
    },
    "budget_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "budget", "reference_price", "current_transaction_quote", "message"],
      "properties": {
        "status": {"enum": ["not_provided", "not_evaluated", "potential_conflict_pending_confirmation", "within_public_reference_pending_confirmation"]},
        "budget": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["min", "max", "currency", "scope", "quantity", "complete"],
          "properties": {
            "min": {"type": "number", "minimum": 0},
            "max": {"type": "number", "minimum": 0},
            "currency": {"type": ["string", "null"]},
            "scope": {"type": ["string", "null"]},
            "quantity": {"type": ["integer", "null"], "minimum": 1},
            "complete": {"type": "boolean"}
          }
        },
        "reference_price": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["amount_cents", "currency", "price_type", "sku", "condition", "source_title", "source_entry", "verified_at", "record_id", "record_status", "current_transaction_quote"],
          "properties": {
            "amount_cents": {"type": "integer", "minimum": 1},
            "currency": {"const": "CNY"},
            "price_type": {"type": "string", "minLength": 1},
            "sku": {"type": ["string", "null"]},
            "condition": {"type": ["string", "null"]},
            "source_title": {"type": "string", "minLength": 1},
            "source_entry": {"type": "string", "minLength": 1},
            "verified_at": {"type": ["string", "null"]},
            "record_id": {"type": ["string", "null"]},
            "record_status": {"type": "string", "minLength": 1},
            "current_transaction_quote": {"const": false}
          }
        },
        "current_transaction_quote": {"const": false},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "profile_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "scenario", "industry", "company_size", "needs", "preferences", "pain_points", "budget_status"],
      "properties": {
        "audience": {"type": ["string", "null"]},
        "scenario": {"type": ["string", "null"]},
        "industry": {"type": ["string", "null"]},
        "company_size": {"type": ["integer", "null"]},
        "needs": {"type": "array", "items": {"type": "string"}},
        "preferences": {"type": "array", "items": {"type": "string"}},
        "pain_points": {"type": "array", "items": {"type": "string"}},
        "budget_status": {"type": "string", "minLength": 1}
      }
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "lead", "body_markdown", "cta", "tags"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "lead": {"type": "string", "minLength": 1},
        "body_markdown": {"type": "string", "minLength": 1},
        "cta": {"type": "string", "minLength": 1},
        "tags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "image_sources": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image_id", "product", "file_name", "caption", "position", "marker", "asset_url", "original_url", "page_url", "source_name", "ima_entry", "ima_kb_name", "ima_kb_id", "ima_search_request_ids", "sha256", "mime_type", "model_match_status", "visual_review_status", "rights_status", "source_status", "source_checked_at", "reviewed_at", "visual_review_note", "formal_publication_verified", "publication_ready"],
        "properties": {
          "image_id": {"type": "string", "minLength": 1},
          "product": {"type": "string", "minLength": 1},
          "file_name": {"type": "string", "minLength": 1},
          "caption": {"type": "string", "minLength": 1},
          "position": {"type": "string", "minLength": 1},
          "marker": {"type": "string", "minLength": 1},
          "asset_url": {"type": "string", "minLength": 1},
          "original_url": {"type": "string", "minLength": 1},
          "page_url": {"type": ["string", "null"]},
          "source_name": {"type": "string", "minLength": 1},
          "ima_entry": {"type": "string", "minLength": 1},
          "ima_kb_name": {"type": "string", "minLength": 1},
          "ima_kb_id": {"type": "string", "minLength": 1},
          "ima_search_request_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "sha256": {"type": "string", "minLength": 1},
          "mime_type": {"type": "string", "minLength": 1},
          "model_match_status": {"type": "string", "minLength": 1},
          "visual_review_status": {"type": "string", "minLength": 1},
          "rights_status": {"type": "string", "minLength": 1},
          "source_status": {"type": "string", "minLength": 1},
          "source_checked_at": {"type": ["string", "null"]},
          "reviewed_at": {"type": ["string", "null"]},
          "visual_review_note": {"type": ["string", "null"]},
          "formal_publication_verified": {"type": "boolean"},
          "publication_ready": {"type": "boolean"}
        }
      }
    },
    "insertion_plan": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["after_marker", "position", "image_id", "caption", "instruction"],
        "properties": {
          "after_marker": {"type": "string", "minLength": 1},
          "position": {"type": "string", "minLength": 1},
          "image_id": {"type": "string", "minLength": 1},
          "caption": {"type": "string", "minLength": 1},
          "instruction": {"type": "string", "minLength": 1}
        }
      }
    },
    "citations": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "claim", "used_in", "source_title", "source_url", "source_entry", "source_sha256"],
        "properties": {
          "fact_id": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "used_in": {"const": "body"},
          "source_title": {"type": "string", "minLength": 1},
          "source_url": {"type": ["string", "null"]},
          "source_entry": {"type": "string", "minLength": 1},
          "source_sha256": {"type": ["string", "null"]}
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "policy_version", "checked_at", "overall_status", "status_label", "publication_ready", "safe_content_ready", "items", "risk_items", "summary", "safe_content", "product_model_match", "evidence_traceable", "image_count", "compliance", "pending"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "policy_version": {"const": "mandatory-release-verification-v1"},
        "checked_at": {"type": "string", "minLength": 1},
        "overall_status": {"enum": ["passed", "downgraded", "blocked"]},
        "status_label": {"enum": ["通过", "降级", "阻塞"]},
        "publication_ready": {"type": "boolean"},
        "safe_content_ready": {"type": "boolean"},
        "items": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "status", "status_label", "summary", "details"],
            "properties": {
              "id": {"enum": ["product_model", "parameters", "price", "image_identity", "overreach", "source_completeness"]},
              "label": {"enum": ["型号", "参数", "价格", "图片身份", "超范围承诺", "来源完整性"]},
              "status": {"enum": ["pass", "fail", "downgrade"]},
              "status_label": {"enum": ["通过", "不通过", "降级"]},
              "summary": {"type": "string", "minLength": 1},
              "details": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "risk_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "check_id", "title", "risk_level", "risk_level_label", "issue", "recommendation", "affected", "status"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "check_id": {"enum": ["product_model", "parameters", "price", "image_identity", "overreach", "source_completeness"]},
              "title": {"type": "string", "minLength": 1},
              "risk_level": {"enum": ["blocking", "downgrade"]},
              "risk_level_label": {"enum": ["阻塞", "降级"]},
              "issue": {"type": "string", "minLength": 1},
              "recommendation": {"type": "string", "minLength": 1},
              "affected": {"type": "array", "items": {"type": "string"}},
              "status": {"enum": ["open", "mitigated_in_safe_version"]}
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pass_count", "downgrade_count", "fail_count", "blocking_risk_count", "downgrade_risk_count"],
          "properties": {
            "pass_count": {"type": "integer", "minimum": 0, "maximum": 6},
            "downgrade_count": {"type": "integer", "minimum": 0, "maximum": 6},
            "fail_count": {"type": "integer", "minimum": 0, "maximum": 6},
            "blocking_risk_count": {"type": "integer", "minimum": 0},
            "downgrade_risk_count": {"type": "integer", "minimum": 0}
          }
        },
        "safe_content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ready", "disclosures", "content", "rendered_markdown"],
          "properties": {
            "ready": {"type": "boolean"},
            "disclosures": {"type": "array", "items": {"type": "string"}},
            "content": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["title", "lead", "body_markdown", "cta", "tags", "image_ids"],
              "properties": {
                "title": {"type": "string", "minLength": 1},
                "lead": {"type": "string", "minLength": 1},
                "body_markdown": {"type": "string", "minLength": 1},
                "cta": {"type": "string", "minLength": 1},
                "tags": {"type": "array", "items": {"type": "string"}},
                "image_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
              }
            },
            "rendered_markdown": {"type": "string"}
          }
        },
        "product_model_match": {"enum": ["verified", "failed"]},
        "evidence_traceable": {"type": "boolean"},
        "image_count": {"type": "integer", "minimum": 0},
        "compliance": {"enum": ["pass", "downgraded", "fail"]},
        "pending": {"type": "array", "items": {"type": "string"}}
      }
    },
    "article_markdown": {"type": "string", "minLength": 1},
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
