{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:huawei-growth:pricing-output:1.0",
  "title": "四级报价扩展输出 v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "status", "demo_only", "actual_transaction_quote", "product", "sku", "quantity", "currency", "effective", "rounding", "unit_amount_cents", "amount_cents", "trace", "input_provenance", "budget_check", "diagnostics"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"enum": ["demo_only", "real"]},
    "status": {"enum": ["calculated_demo", "blocked", "invalid_input"]},
    "demo_only": {"type": "boolean"},
    "actual_transaction_quote": {"const": false},
    "product": {"type": ["string", "null"]},
    "sku": {"type": ["string", "null"]},
    "quantity": {"type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991},
    "currency": {"enum": ["CNY", null]},
    "effective": {
      "type": "object",
      "required": ["as_of", "valid_from", "valid_to", "region", "matched"],
      "additionalProperties": false,
      "properties": {
        "as_of": {"type": ["string", "null"]},
        "valid_from": {"type": ["string", "null"]},
        "valid_to": {"type": ["string", "null"]},
        "region": {"type": ["string", "null"]},
        "matched": {"type": "boolean"}
      }
    },
    "rounding": {"const": "half_up_to_cent_each_level"},
    "unit_amount_cents": {"$ref": "#/$defs/nullableMoney"},
    "amount_cents": {"$ref": "#/$defs/nullableMoney"},
    "trace": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "operation", "value", "before_cents", "raw_after_cents", "discount_cents", "after_cents", "cap_discount_cents", "formula", "source"],
        "properties": {
          "level": {"type": "integer", "minimum": 1, "maximum": 4},
          "operation": {"enum": ["fixed_discount_cents", "discount_basis_points"]},
          "value": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "before_cents": {"$ref": "#/$defs/money"},
          "raw_after_cents": {"$ref": "#/$defs/money"},
          "discount_cents": {"$ref": "#/$defs/money"},
          "after_cents": {"$ref": "#/$defs/money"},
          "cap_discount_cents": {"$ref": "#/$defs/nullableMoney"},
          "formula": {"type": "string", "minLength": 1},
          "source": {"$ref": "#/$defs/source"}
        }
      }
    },
    "input_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_source", "synthetic", "authorization_verified", "calculation_scope", "tax_treatment"],
      "properties": {
        "policy_id": {"type": ["string", "null"]},
        "policy_source": {"anyOf": [{"$ref": "#/$defs/source"}, {"type": "null"}]},
        "synthetic": {"type": "boolean"},
        "authorization_verified": {"const": false},
        "calculation_scope": {"const": "per_unit_then_quantity"},
        "tax_treatment": {"const": "base_includes_tax_no_additional_tax"}
      }
    },
    "budget_check": {"enum": ["unknown", "within_budget", "insufficient", "not_evaluated"]},
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "calculated_demo"}}}, "then": {"properties": {"mode": {"const": "demo_only"}, "demo_only": {"const": true}, "unit_amount_cents": {"type": "integer"}, "amount_cents": {"type": "integer"}, "trace": {"minItems": 4}, "input_provenance": {"properties": {"synthetic": {"const": true}}}}}},
    {"if": {"properties": {"status": {"enum": ["blocked", "invalid_input"]}}}, "then": {"properties": {"unit_amount_cents": {"type": "null"}, "amount_cents": {"type": "null"}}}},
    {"if": {"properties": {"mode": {"const": "real"}}}, "then": {"properties": {"status": {"enum": ["blocked", "invalid_input"]}, "demo_only": {"const": false}, "input_provenance": {"properties": {"synthetic": {"const": false}}}}}}
  ],
  "$defs": {
    "money": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "nullableMoney": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "entry", "description"],
      "properties": {
        "kind": {"enum": ["synthetic_fixture", "authorized_policy"]},
        "title": {"type": "string", "minLength": 1},
        "entry": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    }
  }
}
