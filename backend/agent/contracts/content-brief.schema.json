{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:huawei-growth:content-brief:1.0",
  "title": "内容策略子 Agent 写作任务书 ContentBrief v1.0",
  "description": "内容策略子 Agent 交给写作和质检阶段的唯一写作任务书。只允许引用证据阶段已存在的事实ID和图片ID；不得新增事实、价格、客户身份或平台效果承诺。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "platform", "audience", "reader_problem", "objective", "angle", "proof_points", "structure", "tone", "image_plan", "cta", "constraints"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "platform": {"enum": ["小红书", "公众号", "朋友圈", "其他"]},
    "audience": {"type": "string", "minLength": 1, "maxLength": 200},
    "reader_problem": {"type": "string", "minLength": 1, "maxLength": 400},
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": {"enum": ["consult", "reply", "quote_request", "visit", "demo"]},
        "secondary": {"type": ["string", "null"], "maxLength": 100}
      }
    },
    "angle": {"type": "string", "minLength": 1, "maxLength": 400},
    "proof_points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "role", "order", "reason"],
        "properties": {
          "fact_id": {"type": "string", "pattern": "^fact-[A-Za-z0-9._-]{1,60}$"},
          "role": {"enum": ["core", "supporting", "risk_control"]},
          "order": {"type": "integer", "minimum": 1, "maximum": 12},
          "reason": {"type": "string", "minLength": 1, "maxLength": 300}
        }
      }
    },
    "structure": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section", "purpose", "fact_ids"],
        "properties": {
          "section": {"type": "string", "minLength": 1, "maxLength": 100},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 300},
          "fact_ids": {"type": "array", "maxItems": 12, "items": {"type": "string", "pattern": "^fact-[A-Za-z0-9._-]{1,60}$"}}
        }
      }
    },
    "tone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "avoid"],
      "properties": {
        "style": {"type": "string", "minLength": 1, "maxLength": 200},
        "avoid": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1}}
      }
    },
    "image_plan": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image_id", "position", "purpose"],
        "properties": {
          "image_id": {"type": "string", "pattern": "^image-[A-Za-z0-9._-]{1,60}$"},
          "position": {"enum": ["cover", "after_lead", "section", "before_cta"]},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "text_direction", "channel"],
      "properties": {
        "goal": {"enum": ["consult", "reply", "quote_request", "visit", "demo"]},
        "text_direction": {"type": "string", "minLength": 1, "maxLength": 300},
        "channel": {"type": ["string", "null"], "maxLength": 100}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length_hint", "compliance", "forbidden_claims"],
      "properties": {
        "length_hint": {"type": "string", "minLength": 1, "maxLength": 100},
        "compliance": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1}},
        "forbidden_claims": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
