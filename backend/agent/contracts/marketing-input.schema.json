{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:huawei-growth:marketing-input:1.0",
  "title": "阶段二营销 CLI 输入 v1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0", "default": "1.0"},
    "mode": {"enum": ["local", "ima"], "default": "local"},
    "product": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "platform": {"enum": ["小红书", "公众号", "朋友圈"]},
    "raw_request": {"type": "string", "minLength": 1},
    "intent": {"enum": ["marketing", "quote", "both"], "default": "marketing"},
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "relationship": {"enum": ["新客", "老客", "待确认"]},
        "industry": {"type": "string", "minLength": 1},
        "company_size": {"type": "string", "minLength": 1},
        "needs": {"$ref": "#/$defs/stringList"},
        "budget": {"$ref": "#/$defs/budget"},
        "decision_chain": {"$ref": "#/$defs/stringList"},
        "preferences": {"$ref": "#/$defs/stringList"},
        "pain_points": {"$ref": "#/$defs/stringList"},
        "purchase_stage": {"type": "string", "minLength": 1},
        "channels": {"$ref": "#/$defs/stringList"}
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_result_path", "instructions"],
      "properties": {
        "previous_result_path": {"type": "string", "minLength": 1},
        "instructions": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "stringList": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {"type": "number", "minimum": 0},
        "max": {"type": "number", "minimum": 0},
        "currency": {"type": "string", "minLength": 1},
        "scope": {"enum": ["单台", "总额", "待确认"]},
        "quantity": {"type": "integer", "minimum": 1},
        "source_text": {"type": "string", "minLength": 1}
      },
      "minProperties": 1
    }
  }
}
