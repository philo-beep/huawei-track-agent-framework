# 复制为 .env 后填写；不要把真实密钥提交到 Git 或写入镜像。
CLOUD_MODEL_PROVIDER=openai-compatible
CLOUD_MODEL_BASE_URL=https://api.openai-next.com/v1
CLOUD_MODEL_API_KEY=replace-with-cloud-model-key
CLOUD_MODEL_NAME=deepseek-v4.1-flash
CLOUD_MODEL_TIMEOUT_MS=120000

IMA_OPENAPI_CLIENTID=replace-with-ima-client-id
IMA_OPENAPI_APIKEY=replace-with-ima-api-key
IMA_OPENAPI_BASE_URL=https://ima.qq.com
IMA_OPENAPI_DEFAULT_KB_ID=replace-with-knowledge-base-id
IMA_OPENAPI_DEFAULT_KB_NAME=任德耀新建华为PC知识库
IMA_OPENAPI_TIMEOUT_MS=30000

WEB_RESEARCH_ENABLED=1
WEB_SEARCH_BASE_URL=https://www.bing.com/search
WEB_RESEARCH_TIMEOUT_MS=20000
WEB_RESEARCH_MAX_BYTES=1048576