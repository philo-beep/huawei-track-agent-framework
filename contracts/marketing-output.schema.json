{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:huawei-growth:marketing-output:1.0",
  "title": "阶段二营销 CLI 四部分输出 v1.0",
  "type": "object",
  "required": ["schema_version", "requested_mode", "mode", "ima_connection", "status", "competition_readiness", "profile", "clarification_questions", "scenario_judgment", "knowledge_basis", "marketing_content", "verification", "sales_preparation", "diagnostics"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "requested_mode": {"enum": ["local", "ima"]},
    "mode": {"enum": ["local", "ima"]},
    "ima_connection": {"enum": ["connected", "not_connected", "not_requested"]},
    "status": {"enum": ["ready", "needs_clarification", "blocked"]},
    "competition_readiness": {"enum": ["offline_only", "ima_evidence_present", "not_verified"]},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "relationship", "industry", "company_size", "needs", "budget", "decision_chain", "preferences", "pain_points", "purchase_stage", "channels"],
      "properties": {
        "identity": {"$ref": "#/$defs/profileField"},
        "relationship": {"$ref": "#/$defs/profileField"},
        "industry": {"$ref": "#/$defs/profileField"},
        "company_size": {"$ref": "#/$defs/profileField"},
        "needs": {"$ref": "#/$defs/profileField"},
        "budget": {"$ref": "#/$defs/profileField"},
        "decision_chain": {"$ref": "#/$defs/profileField"},
        "preferences": {"$ref": "#/$defs/profileField"},
        "pain_points": {"$ref": "#/$defs/profileField"},
        "purchase_stage": {"$ref": "#/$defs/profileField"},
        "channels": {"$ref": "#/$defs/profileField"}
      }
    },
    "clarification_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "question", "blocks"],
        "additionalProperties": false,
        "properties": {
          "field": {"type": "string"},
          "question": {"type": "string", "minLength": 1},
          "blocks": {"enum": ["content", "quote", "none"]}
        }
      }
    },
    "scenario_judgment": {
      "type": "object",
      "required": ["audience", "scenario", "user_problem", "content_goal", "platform", "strategy"],
      "additionalProperties": false,
      "properties": {
        "audience": {"type": ["string", "null"]},
        "scenario": {"type": ["string", "null"]},
        "user_problem": {"type": ["string", "null"]},
        "content_goal": {"type": ["string", "null"]},
        "platform": {"enum": ["小红书", "公众号", "朋友圈", null]},
        "strategy": {"type": ["object", "null"]}
      }
    },
    "knowledge_basis": {
      "type": "object",
      "required": ["product", "facts", "source_mode"],
      "additionalProperties": false,
      "properties": {
        "product": {"type": ["string", "null"]},
        "source_mode": {"enum": ["local_zip", "official_snapshot", "ima", "none"]},
        "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}}
      }
    },
    "marketing_content": {
      "type": ["object", "null"],
      "required": ["title", "lead", "body", "cta", "images", "fact_ids"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "lead": {"type": "string"},
        "body": {"type": "string", "minLength": 1},
        "cta": {"type": "string", "minLength": 1},
        "fact_ids": {"type": "array", "items": {"type": "string"}},
        "images": {"type": "array", "items": {"$ref": "#/$defs/image"}}
      }
    },
    "verification": {
      "type": "object",
      "required": ["product_facts", "image_model", "compliance", "pending_information", "issues"],
      "additionalProperties": false,
      "properties": {
        "product_facts": {"$ref": "#/$defs/checkStatus"},
        "image_model": {"$ref": "#/$defs/checkStatus"},
        "compliance": {"$ref": "#/$defs/checkStatus"},
        "pending_information": {"type": "array", "items": {"type": "string"}},
        "issues": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sales_preparation": {
      "type": "object",
      "required": ["quote", "demo_plan", "next_actions", "conversion_effect"],
      "additionalProperties": false,
      "properties": {
        "quote": {
          "type": "object",
          "required": ["status", "amount", "reason", "required_information"],
          "additionalProperties": false,
          "properties": {
            "status": {"const": "blocked"},
            "amount": {"type": "null"},
            "reason": {"type": "string", "minLength": 1},
            "required_information": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        },
        "demo_plan": {
          "type": "object",
          "required": ["status", "checklist", "elapsed_seconds", "within_30_minutes_verified"],
          "additionalProperties": false,
          "properties": {
            "status": {"const": "preparation_only"},
            "checklist": {"type": "array", "items": {"type": "string"}},
            "elapsed_seconds": {"type": ["number", "null"], "minimum": 0},
            "within_30_minutes_verified": {"const": false}
          }
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["action", "owner", "trigger", "pending_dependencies"],
            "additionalProperties": false,
            "properties": {
              "action": {"type": "string", "minLength": 1},
              "owner": {"type": "string", "minLength": 1},
              "trigger": {"type": "string", "minLength": 1},
              "pending_dependencies": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "conversion_effect": {"const": "not_measured"}
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "retryable"],
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "retryable": {"type": "boolean"}
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"mode": {"const": "local"}}}, "then": {"properties": {"competition_readiness": {"const": "offline_only"}, "ima_connection": {"enum": ["not_connected", "not_requested"]}, "knowledge_basis": {"properties": {"source_mode": {"enum": ["local_zip", "official_snapshot", "none"]}}}}}},
    {"if": {"properties": {"mode": {"const": "ima"}}}, "then": {"properties": {"requested_mode": {"const": "ima"}, "ima_connection": {"const": "connected"}, "knowledge_basis": {"properties": {"source_mode": {"const": "ima"}}}}}},
    {"if": {"properties": {"status": {"enum": ["needs_clarification", "blocked"]}}}, "then": {"properties": {"marketing_content": {"type": "null"}}}},
    {"if": {"properties": {"status": {"const": "ready"}}}, "then": {"properties": {"marketing_content": {"type": "object"}}}}
  ],
  "$defs": {
    "checkStatus": {"enum": ["pass", "fail", "pending", "not_run"]},
    "profileField": {
      "type": "object",
      "required": ["value", "status", "evidence", "reason", "confidence"],
      "additionalProperties": false,
      "properties": {
        "value": {"type": ["string", "number", "object", "array", "null"]},
        "status": {"enum": ["explicit", "inferred", "pending"]},
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["input_path", "quote"],
            "additionalProperties": false,
            "properties": {"input_path": {"type": "string", "minLength": 1}, "quote": {"type": "string", "minLength": 1}}
          }
        },
        "reason": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "pending"}}}, "then": {"properties": {"value": {"type": "null"}, "confidence": {"const": 0}}}},
        {"if": {"properties": {"status": {"enum": ["explicit", "inferred"]}}}, "then": {"properties": {"value": {"not": {"type": "null"}}, "evidence": {"minItems": 1}}}}
      ]
    },
    "source": {
      "type": "object",
      "required": ["title", "archive_aliases", "entry", "entry_sha256", "urls", "excerpt"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "archive_aliases": {"type": "array", "items": {"type": "string"}},
        "entry": {"type": "string", "minLength": 1},
        "entry_sha256": {"type": ["string", "null"]},
        "urls": {"type": "array", "items": {"type": "string"}},
        "excerpt": {"type": "string", "minLength": 1}
      }
    },
    "fact": {
      "type": "object",
      "required": ["id", "product", "claim", "conditions", "source_refs"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "conditions": {"type": "array", "items": {"type": "string"}},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
      }
    },
    "image": {
      "type": "object",
      "required": ["name", "product", "source_refs", "position", "caption", "model_verified", "local_path"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
        "position": {"type": "string", "minLength": 1},
        "caption": {"type": "string", "minLength": 1},
        "model_verified": {"const": true},
        "local_path": {"type": ["string", "null"]}
      }
    }
  }
}
